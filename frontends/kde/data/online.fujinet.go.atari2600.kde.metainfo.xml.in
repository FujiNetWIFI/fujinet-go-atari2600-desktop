<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>online.fujinet.go.atari2600.kde</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>FujiNet Go Atari 2600 (KDE)</name>
  <summary>An Atari 2600 with a built-in FujiNet</summary>
  <description>
    <p>
      A self-contained Atari 2600 with a FujiNet built in: browse a network
      host from the console, boot cartridges over the network, and let the
      booted program keep talking to the network, all in one application.
    </p>
    <p>
      The emulator is Stella, with the FujiNet cartridge running the real
      cartridge firmware's own protocol sources, so it behaves exactly as the
      hardware does. Joysticks, paddles, driving controllers and keypads can
      be chosen per port, gamepads are picked up as they are plugged in, and
      Stella's complete debugger is available in a native window, and a
      built-in, searchable Help covers all of it.
    </p>
    <p>
      Nothing copyrighted is included: the Atari 2600 has no system ROM, and
      the only built-in program is FujiNet's own CONFIG client.
    </p>
  </description>
  <launchable type="desktop-id">online.fujinet.go.atari2600.kde.desktop</launchable>
  <icon type="stock">online.fujinet.go.atari2600.kde</icon>
  <!-- Software centres classify from these, not from the .desktop
       Categories= line; without them the app lands in no section at all. -->
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <url type="homepage">https://fujinet.online/</url>
  <url type="bugtracker">https://github.com/FujiNetWIFI/fujinet-go-atari2600-desktop/issues</url>
  <developer id="online.fujinet">
    <name>FujiNet</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <caption>The FujiNet CONFIG client browsing network hosts from the console</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-atari2600-desktop/v0.3.1/data/screenshots/kde/1_running_config.png</image>
    </screenshot>
    <screenshot>
      <caption>The built-in debugger: the BASIC tab steps a batari Basic program by source line</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-atari2600-desktop/v0.8.0/data/screenshots/kde/2_debugger.png</image>
    </screenshot>
    <screenshot>
      <caption>Both keypad controllers</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-atari2600-desktop/v0.3.1/data/screenshots/kde/3_keypads.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <!-- The CURRENT release templates its version from @PROJECT_VERSION@, so
         it cannot disagree with the tree; past releases are literal. The
         release job checks that this first entry is still a template. -->
    <release version="@PROJECT_VERSION@" date="2026-11-11">
      <description>
        <p>
          Debug a batari Basic program by its source. The debugger has a new BASIC tab: import a .bas file or folder (the listing and symbol files batari Basic writes beside it are found for you, and a cartridge with its .bas next to it imports itself), click a line to set a breakpoint, and Step, Step Over and Step Out go by BASIC line while the tab shows. Variables carry their source names in Memory, Watches and the Console. This makes thirteen tabs.
        </p>
        <p>
          Fixed: Atari 2600 dumps with long names, nearly every .a26 on a network host (such as "Action Man - Action Force (Europe).a26"), failed to boot from CONFIG with BOOT FAILED. The CONFIG client now reads the whole file name when you pick a file.
        </p>
      </description>
    </release>
    <release version="0.7.0" date="2026-11-10">
      <description>
        <p>
          New debugger, the same as the other FujiNet Go desktops: twelve tabs (Console, Disassembly, Memory, Breakpoints, Watches, Cart &amp; I/O, Trace, History, Video, Sound, Symbols, FujiNet) with the registers under all of them, any tab can pop out into its own window. Breakpoints can be switched off and count their hits, read, write and access breakpoints say what was written and what it replaced, and the Memory tab goes to ranges, searches and labels what answers where. Trace and History record every instruction. The Video tab replaces the TIA tab: it records what the TIA was set to on every scan line, so you can see what drew each pixel, where a game changes colours or sprites mid-frame, and stop on a write to a register.
        </p>
      </description>
    </release>
    <release version="0.6.0" date="2026-11-08">
      <description>
        <p>
          Built-in, searchable Help: Help menu (Ctrl+Shift+H, ⌘? on a Mac) and Help buttons in Preferences, the debugger and the console log open the topic for what they show.
        </p>
      </description>
    </release>
    <release version="0.5.1" date="2026-11-07">
      <description>
        <p>
          Fixed a freeze when a gamepad trigger was pressed with the Controllers window open.
        </p>
      </description>
    </release>
    <release version="0.5.0" date="2026-11-01">
          <description>
            <p>
              Lower CPU use: the picture is drawn on the GPU (with a software fallback) only when the emulator has a new frame, and the display stops updating while the window is hidden. The built-in FujiNet wakes about a tenth as often when nothing is happening. Fixed: the machine could run faster than real time on displays faster than 60 Hz. Needs Qt 6.7 or newer.
            </p>
          </description>
        </release>
        <release version="0.4.0" date="2026-10-29">
      <description>
        <p>
          New: use an external FujiNet. A switch in Preferences makes the app connect to another FujiNet instance at a host:port you enter (for example 127.0.0.1:11504) instead of starting the built-in one.
        </p>
      </description>
    </release>
    <release version="0.3.2" date="2026-10-27">
          <description>
            <p>
              The Flatpak bundles now name Flathub as their runtime repository, so a downloaded bundle can fetch the GNOME or KDE runtime on a machine that has not set up Flathub.
            </p>
          </description>
        </release>
        <release version="0.3.1" date="2026-10-27">
      <description>
        <p>
          The Flatpak builds on the GNOME 51 runtime. The software-centre
          listing now credits FujiNet as developer, declares the app icon,
          and shows a full set of screenshots for each frontend.
        </p>
      </description>
    </release>
    <release version="0.3.0" date="2026-10-26">
      <description>
        <p>
          Windows draws with Direct3D 11, presented on vblank, instead of
          GDI, and its FujiNet console log is no longer empty. .a26 images
          boot from CONFIG, and CONFIG no longer stalls with ERR FF
          between it and the cartridge.
        </p>
      </description>
    </release>
    <release version="0.2.2" date="2026-10-20">
      <description>
        <p>
          The built-in CONFIG gets colour, a frame, a selection bar and
          sound cues.
        </p>
      </description>
    </release>
    <release version="0.2.1" date="2026-10-19">
      <description>
        <p>
          Fixes a buzz over silence, heard at start-up in CONFIG: half
          of every audio buffer went out unwritten.
        </p>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-19">
      <description>
        <p>
          Debugger: a FujiNet tab shows every FujiBus packet between the 2600
          and FujiNet, both ways, with hex.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-20">
      <description>
        <p>
          First release: Stella with the FujiNet cartridge, an in-process
          FujiNet, native GNOME, KDE, macOS and Windows frontends, both keypad
          controllers on screen, per-port controller types, hotplugged
          gamepads and the complete Stella debugger.
        </p>
      </description>
    </release>
  </releases>
</component>
